# Copy this file to .streamlit/secrets.toml (gitignored) and fill in real values.
# Never commit the real secrets.toml.

admin_password = "change-me"

# Supabase connection string. In the Supabase dashboard: Project Settings -> Database
# -> Connection string -> URI. Use the "Session pooler" or direct connection string
# (not "Transaction pooler") since it's the most compatible with plain psycopg use.
postgres_url = "postgresql://postgres.xxxxxxxx:YOUR-PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres"
